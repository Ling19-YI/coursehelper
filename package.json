{
  "name": "coursehelper",
  "productName": "刷课助手 CourseHelper",
  "version": "2.1.0",
  "description": "超星学习通自动刷课助手",
  "main": "app/dist/main/index.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "smoke": "node scripts/smoke.mjs",
    "spike": "node scripts/spike.mjs",
    "test:answer": "tsx scripts/test-answer-chain.ts",
    "test:vision": "tsx scripts/test-vision-answer.ts",
    "test": "npm run typecheck && npm run test:answer && npm run test:vision && npm run test:popup && npm run test:ai-silent && npm run test:channel && npm run test:mixed && npm run test:switch && npm run test:budget",
    "test:popup": "tsx scripts/test-video-popup.ts",
    "test:ai-silent": "tsx scripts/test-ai-silent-failure.ts",
    "test:budget": "tsx scripts/test-reasoning-budget.ts",
    "test:mixed": "tsx scripts/test-mixed-chapter.ts",
    "test:mixed-dom": "tsx scripts/test-mixed-chapter-dom.ts",
    "test:switch": "tsx scripts/test-manual-switch.ts",
    "test:switch-dom": "tsx scripts/test-manual-switch-dom.ts",
    "test:e2e": "tsx scripts/e2e-real-engine.ts",
    "test:channel": "node scripts/test-channel.mjs"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "antd": "^6.0.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "electron@44.6.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "author": "CourseHelper",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
